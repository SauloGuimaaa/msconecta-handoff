# Somente NOMES. Preencha no computador do Heitor; nunca commitar o .env real.
# --- Instagram (contas de TESTE primeiro) ---
IG_USERNAME=
# A senha NAO vai em arquivo: login manual no perfil dedicado do navegador (ver 05).
# --- Operacao ---
PERFIL_NAVEGADOR_DIR=          # pasta propria do robo, criada pelo Heitor
PASTA_ENTRADA=                 # onde chegam os JSON de noticia (04)
PASTA_ESTADO=                  # estado.json de idempotencia
PASTA_ERROS=                   # screenshots de falha
LISTENER_PORT=8765
LISTENER_TOKEN=                # segredo compartilhado com quem dispara (novo; nao existe no original)
INTERVALO_MIN_MINUTOS=20
INTERVALO_JITTER_MAX_MINUTOS=5
JANELA_INICIO_HORA=9
JANELA_FIM_HORA=20
MAX_POSTS_DIA_STORY=30
MAX_POSTS_DIA_CANAL=30
MODO_TESTE=true                # true = nunca clica em Compartilhar/Enviar
ALERTA_TELEGRAM_BOT_TOKEN=     # opcional
ALERTA_TELEGRAM_CHAT_ID=       # opcional
